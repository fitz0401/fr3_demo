@@ -0,0 +1,223 @@
+"""Verify an exported checkpoint loads standalone, and characterise its input/output contract.
+
+Answers three questions before the model is shipped to a robot:
+
+1. Does a checkpoint stripped to `params/` + `assets/` (no `train_state/`) load and run? That is
+   what gets downloaded, so it must be sufficient on its own.
+2. Which inputs actually influence the output? `pi05=True` with `discrete_state_input=False` leaves
+   the model with no pathway for proprioceptive state, so `observation/joint_position` and
+   `observation/gripper_position` should provably not change the actions. Positive controls (image,
+   prompt, noise) must change them, otherwise a bug in this script would fake the same result.
+3. What is the inference latency, which decides what control rates the deployment can sustain.
+
+All comparisons pass the same fixed `noise` to `Policy.infer`, so the flow-matching sampler is
+deterministic and any output difference comes from the input under test.
+
+    uv run scripts/verify_export.py --config-name pi05_custom_droid_hybrid \
+        --checkpoint-dir checkpoints/pi05_custom_droid_hybrid/b0_custom_droid_full_15k/14999 \
+        --export-dir /leonardo_work/EUHPC_D35_005/openpi/artifacts/export/pi05_custom_droid_14999
+"""
+
+import dataclasses
+import functools
+import json
+import logging
+import pathlib
+import shutil
+import time
+
+import numpy as np
+import tyro
+
+from openpi.policies import policy_config as _policy_config
+from openpi.training import config as _config
+
+
+@dataclasses.dataclass
+class Args:
+    config_name: str = "pi05_custom_droid_hybrid"
+    checkpoint_dir: str = "checkpoints/pi05_custom_droid_hybrid/b0_custom_droid_full_15k/14999"
+    # Deployment copy to create and test. Only `params/` and `assets/` are copied.
+    export_dir: str = "artifacts/export/pi05_custom_droid_14999"
+    # Skip the copy and test an existing export dir.
+    skip_copy: bool = False
+    # Prompt the model was fine-tuned on.
+    prompt: str = "pour lillet into the jigger"
+    # A different in-distribution task, used as the prompt-sensitivity control.
+    alt_prompt: str = "pour gin into the jigger"
+    # Native camera resolution of the dataset; the policy resizes to 224x224 itself.
+    image_hw: tuple[int, int] = (180, 320)
+    latency_reps: int = 10
+    out_json: str | None = None
+
+
+def _example(
+    rng: np.random.Generator,
+    args: Args,
+    *,
+    state_seed: int,
+    image_seed: int,
+    prompt: str,
+    num_state_frames: int = 1,
+    history_seed: int | None = None,
+) -> dict:
+    """One request. With history the state keys carry `num_state_frames` stacked frames, current first.
+
+    `history_seed`, when given, drives only the lagged frames, so a request can differ from another
+    in its history alone while the present is bit-identical. That is what shows whether the lagged
+    proprioception reaches the output at all.
+    """
+    h, w = args.image_hw
+    img_rng = np.random.default_rng(image_seed)
+    state_rng = np.random.default_rng(state_seed)
+    now_j = state_rng.uniform(-2.0, 2.0, 7).astype(np.float32)
+    now_g = state_rng.uniform(0.0, 1.0, 1).astype(np.float32)
+    if num_state_frames == 1:
+        joints, gripper = now_j, now_g
+    else:
+        hist_rng = np.random.default_rng(state_seed if history_seed is None else history_seed)
+        past_j = hist_rng.uniform(-2.0, 2.0, (num_state_frames - 1, 7)).astype(np.float32)
+        past_g = hist_rng.uniform(0.0, 1.0, (num_state_frames - 1, 1)).astype(np.float32)
+        joints = np.concatenate([now_j[None, :], past_j], axis=0)
+        gripper = np.concatenate([now_g[None, :], past_g], axis=0)
+    return {
+        "observation/exterior_image_1_left": img_rng.integers(0, 256, (h, w, 3), dtype=np.uint8),
+        "observation/wrist_image_left": img_rng.integers(0, 256, (h, w, 3), dtype=np.uint8),
+        "observation/joint_position": joints,
+        "observation/gripper_position": gripper,
+        "prompt": prompt,
+    }
+
+
+def main(args: Args) -> None:
+    # force=True: importing jax/absl installs a root handler above INFO, which makes a plain
+    # basicConfig() a silent no-op and swallows every logging call in this script.
+    logging.basicConfig(
+        level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s", datefmt="%H:%M:%S", force=True
+    )
+    ckpt = pathlib.Path(args.checkpoint_dir)
+    export = pathlib.Path(args.export_dir)
+
+    if not args.skip_copy:
+        export.mkdir(parents=True, exist_ok=True)
+        for item in ("params", "assets"):
+            src, dst = ckpt / item, export / item
+            if dst.exists():
+                logging.info(f"{dst} already present, skipping copy")
+                continue
+            logging.info(f"copying {src} -> {dst}")
+            shutil.copytree(src, dst)
+    size_mb = sum(f.stat().st_size for f in export.rglob("*") if f.is_file()) / 1e6
+    logging.info(f"export dir {export} is {size_mb:.0f} MB")
+
+    config = _config.get_config(args.config_name)
+    logging.info(
+        f"model: pi05={config.model.pi05} discrete_state_input={config.model.discrete_state_input} "
+        f"action_horizon={config.model.action_horizon} action_dim={config.model.action_dim} "
+        f"max_token_len={config.model.max_token_len} "
+        f"paligemma={config.model.paligemma_variant} action_expert={config.model.action_expert_variant}"
+    )
+
+    # Loaded from the export copy, not the original checkpoint: this is the artifact being shipped.
+    policy = _policy_config.create_trained_policy(config, export)
+
+    rng = np.random.default_rng(0)
+    noise = rng.normal(size=(config.model.action_horizon, config.model.action_dim)).astype(np.float32)
+    noise_b = np.random.default_rng(1).normal(
+        size=(config.model.action_horizon, config.model.action_dim)
+    ).astype(np.float32)
+
+    lags = tuple(config.data.state_history_lags) if hasattr(config.data, "state_history_lags") else ()
+    nf = 1 + len(lags)
+    ex = functools.partial(_example, rng, args, num_state_frames=nf)
+    base = ex(state_seed=1, image_seed=100, prompt=args.prompt)
+    variants = {
+        # Whole state replaced, present included.
+        "state_changed": ex(state_seed=2, image_seed=100, prompt=args.prompt),
+        # Positive controls: these MUST change the output.
+        "image_changed": ex(state_seed=1, image_seed=200, prompt=args.prompt),
+        "prompt_changed": ex(state_seed=1, image_seed=100, prompt=args.alt_prompt),
+    }
+    if nf > 1:
+        # Only the lagged frames differ; the present is bit-identical. If this does not move the
+        # output, the history the model was trained with is not reaching it at inference.
+        variants["history_only_changed"] = ex(state_seed=1, image_seed=100, prompt=args.prompt, history_seed=99)
+
+    ref = policy.infer(base, noise=noise)["actions"]
+    logging.info(f"actions shape {ref.shape} dtype {ref.dtype}")
+
+    results = {}
+    for name, obs in variants.items():
+        out = policy.infer(obs, noise=noise)["actions"]
+        diff = float(np.abs(out - ref).max())
+        results[name] = {"max_abs_diff": diff, "identical": bool(np.array_equal(out, ref))}
+        logging.info(f"{name:16s} max|diff| = {diff:.6e}  identical={results[name]['identical']}")
+
+    # Control on the sampler itself: a different noise draw must move the output, otherwise the
+    # `noise` argument is not reaching the sampler and every comparison above is vacuous.
+    out = policy.infer(base, noise=noise_b)["actions"]
+    results["noise_changed"] = {"max_abs_diff": float(np.abs(out - ref).max()), "identical": bool(np.array_equal(out, ref))}
+    logging.info(f"{'noise_changed':16s} max|diff| = {results['noise_changed']['max_abs_diff']:.6e}")
+
+    # Repeatability: same input, same noise, twice.
+    out = policy.infer(base, noise=noise)["actions"]
+    results["repeat_same_noise"] = {"max_abs_diff": float(np.abs(out - ref).max()), "identical": bool(np.array_equal(out, ref))}
+    logging.info(f"{'repeat':16s} max|diff| = {results['repeat_same_noise']['max_abs_diff']:.6e}")
+
+    times = []
+    for _ in range(args.latency_reps):
+        t0 = time.monotonic()
+        policy.infer(base)
+        times.append((time.monotonic() - t0) * 1000)
+    latency = {
+        "mean_ms": float(np.mean(times)),
+        "p50_ms": float(np.percentile(times, 50)),
+        "p90_ms": float(np.percentile(times, 90)),
+        "reps": args.latency_reps,
+    }
+    logging.info(f"latency mean {latency['mean_ms']:.1f} ms, p50 {latency['p50_ms']:.1f}, p90 {latency['p90_ms']:.1f}")
+
+    contract = {
+        "action_shape": list(ref.shape),
+        "action_dtype": str(ref.dtype),
+        "joint_velocity_range": [float(ref[:, :7].min()), float(ref[:, :7].max())],
+        "gripper_range": [float(ref[:, 7].min()), float(ref[:, 7].max())],
+        "export_size_mb": size_mb,
+        "model": {
+            "pi05": config.model.pi05,
+            "discrete_state_input": config.model.discrete_state_input,
+            "action_horizon": config.model.action_horizon,
+            "action_dim": config.model.action_dim,
+            "max_token_len": config.model.max_token_len,
+            "paligemma_variant": config.model.paligemma_variant,
+            "action_expert_variant": config.model.action_expert_variant,
+        },
+    }
+    summary = {"sensitivity": results, "latency": latency, "contract": contract}
+    print("\n" + json.dumps(summary, indent=2))
+
+    out_json = pathlib.Path(args.out_json) if args.out_json else export.parent / f"{export.name}_verify.json"
+    out_json.write_text(json.dumps(summary, indent=2))
+    print(f"\nWrote {out_json}")
+
+    verdict = []
+    if results["state_changed"]["identical"]:
+        verdict.append("STATE IGNORED: proprioception provably does not affect the output.")
+    else:
+        verdict.append(f"STATE USED: changing state moved the actions by {results['state_changed']['max_abs_diff']:.3e}.")
+    if "history_only_changed" in results:
+        if results["history_only_changed"]["identical"]:
+            verdict.append("HISTORY IGNORED: the lagged frames do not affect the output at all.")
+        else:
+            verdict.append(
+                f"HISTORY USED: changing only the lagged frames moved the actions by "
+                f"{results['history_only_changed']['max_abs_diff']:.3e}."
+            )
+    for control in ("image_changed", "prompt_changed", "noise_changed"):
+        if results[control]["identical"]:
+            verdict.append(f"BROKEN CONTROL: {control} produced an identical output -- this test is not valid.")
+    print("\n" + "\n".join(verdict))
+
+
+if __name__ == "__main__":
+    main(tyro.cli(Args))
