+def record_eval_metrics(checkpoint_dir: epath.Path | str, step: int, metrics: dict[str, float]) -> None:
+    """Append one validation record to the checkpoint directory's eval history.
+
+    The history is the authoritative record for best-checkpoint selection: it is kept in a plain
+    JSON sidecar rather than in orbax metadata so that it survives resumes and can be inspected
+    (and corrected) by hand.
+    """
+    if jax.process_index() != 0:
+        return
+    history_path = epath.Path(checkpoint_dir) / EVAL_HISTORY_FILENAME
+    history = json.loads(history_path.read_text()) if history_path.exists() else []
+    # A resumed run can re-evaluate a step that is already recorded; the newer value wins.
+    history = [record for record in history if record["step"] != step]
+    history.append({"step": int(step), **{k: float(v) for k, v in metrics.items()}})
+    history.sort(key=lambda record: record["step"])
+    history_path.write_text(json.dumps(history, indent=2))
+
+
+def best_step(
+    checkpoint_dir: epath.Path | str, metric: str, *, mode: str = "min", among: Iterable[int] | None = None
+) -> int | None:
+    """Step with the best recorded value of `metric`, or None if nothing is recorded."""
+    history_path = epath.Path(checkpoint_dir) / EVAL_HISTORY_FILENAME
+    if not history_path.exists():
+        return None
+    history = [record for record in json.loads(history_path.read_text()) if metric in record]
+    if among is not None:
+        allowed = set(among)
+        history = [record for record in history if record["step"] in allowed]
+    if not history:
+        return None
+    pick = min if mode == "min" else max
+    return int(pick(history, key=lambda record: record[metric])["step"])
+
+
+def prune_to_final_and_best(
+    checkpoint_manager: ocp.CheckpointManager,
+    checkpoint_dir: epath.Path | str,
+    metric: str,
+    *,
+    mode: str = "min",
+) -> None:
+    """Keep only the most recent checkpoint and the best-scoring one; delete the rest.
+
+    The most recent checkpoint is always kept so that a crashed run resumes from where it stopped
+    rather than rolling back to the best step.
+    """
+    if jax.process_index() != 0:
+        return
+    checkpoint_manager.wait_until_finished()
+    steps = sorted(checkpoint_manager.all_steps())
+    if not steps:
+        return
+    keep = {steps[-1]}
+    if (best := best_step(checkpoint_dir, metric, mode=mode, among=steps)) is not None:
+        keep.add(best)
+    for step in steps:
+        if step not in keep:
+            logging.info(f"Deleting checkpoint {step} (keeping {sorted(keep)}: latest + best {metric})")
+            checkpoint_manager.delete(step)
+
