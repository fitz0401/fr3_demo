diff --git a/scripts/launch_leonardo_4gpu_wine.sh b/scripts/launch_leonardo_4gpu_wine.sh
new file mode 100755
index 0000000..f782589
--- /dev/null
+++ b/scripts/launch_leonardo_4gpu_wine.sh
@@ -0,0 +1,129 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run inside one Leonardo Booster node allocation with 4x A100 64GB.
+# Modes: preflight, probe, full.
+#   preflight - one batch through the input pipeline (no training)
+#   probe     - 20 optimizer steps, checks grad norms / throughput / checkpointing
+#   full      - the real pi05_base -> wine post-training run
+MODE="${1:-preflight}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "${ROOT_DIR}"
+
+WORK_ROOT="${WORK_ROOT:-/leonardo_work/EUHPC_D35_005}"
+export HF_LEROBOT_HOME="${HF_LEROBOT_HOME:-${WORK_ROOT}/datasets/lerobot}"
+export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-${WORK_ROOT}/.cache/openpi}"
+export HF_HOME="${HF_HOME:-${WORK_ROOT}/.cache/huggingface}"
+export UV_CACHE_DIR="${UV_CACHE_DIR:-${WORK_ROOT}/.cache/uv}"
+export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-${WORK_ROOT}/.cache/uv/python}"
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
+export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
+export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-false}"
+export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${WORK_ROOT}/.cache/jax}"
+# Compute nodes have no outbound network: everything below must already be on disk.
+export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
+
+CONFIG_NAME="${CONFIG_NAME:-pi05_wine_hybrid}"
+GLOBAL_BATCH="${GLOBAL_BATCH:-64}"
+FSDP_DEVICES="${FSDP_DEVICES:-1}"
+NORM_MAX_FRAMES="${NORM_MAX_FRAMES:-60000}"
+LOG_DIR="${LOG_DIR:-artifacts/leonardo_4gpu_wine}"
+WANDB_ENABLED="${WANDB_ENABLED:-false}"
+RUN_NORM_STATS="${RUN_NORM_STATS:-auto}"  # auto | true | false
+UV_BIN="${UV_BIN:-${WORK_ROOT}/conda/envs/jepa-wms/bin/uv}"
+UV_RUN_ARGS=(run --managed-python --python 3.11 --no-dev --python-platform x86_64-manylinux_2_31)
+RESUME="${RESUME:-false}"
+OVERWRITE="${OVERWRITE:-false}"
+
+case "${MODE}" in
+  preflight)
+    PREFLIGHT_BATCH="${PREFLIGHT_BATCH:-4}"
+    ;;
+  probe)
+    EXP_NAME="${EXP_NAME:-b1_wine_probe_fsdp${FSDP_DEVICES}_gb${GLOBAL_BATCH}}"
+    NUM_TRAIN_STEPS="${NUM_TRAIN_STEPS:-20}"
+    LOG_INTERVAL="${LOG_INTERVAL:-1}"
+    SAVE_INTERVAL="${SAVE_INTERVAL:-10}"
+    ;;
+  scan)
+    # Locate where overfitting starts: short run, fine-grained eval and saves so that every
+    # recorded point has a checkpoint behind it. The 30k run only recorded at its 2,500-step save
+    # interval, so its earliest point was already past the minimum.
+    EXP_NAME="${EXP_NAME:-b1_wine_scan_4k}"
+    NUM_TRAIN_STEPS="${NUM_TRAIN_STEPS:-4000}"
+    LOG_INTERVAL="${LOG_INTERVAL:-100}"
+    SAVE_INTERVAL="${SAVE_INTERVAL:-250}"
+    EVAL_INTERVAL="${EVAL_INTERVAL:-250}"
+    # 16 batches instead of 8 halves the standard error of the mean, which matters when comparing
+    # points near a shallow minimum. Not directly comparable to the 30k run's numbers.
+    EVAL_NUM_BATCHES="${EVAL_NUM_BATCHES:-16}"
+    ;;
+  full)
+    EXP_NAME="${EXP_NAME:-b1_wine_full_30k}"
+    NUM_TRAIN_STEPS="${NUM_TRAIN_STEPS:-30000}"
+    LOG_INTERVAL="${LOG_INTERVAL:-100}"
+    SAVE_INTERVAL="${SAVE_INTERVAL:-2500}"
+    ;;
+  *)
+    echo "Unknown mode: ${MODE}; expected preflight, probe, scan, or full" >&2
+    exit 2
+    ;;
+esac
+
+mkdir -p "${LOG_DIR}" "${OPENPI_DATA_HOME}" "${HF_HOME}" "${UV_CACHE_DIR}" "${JAX_COMPILATION_CACHE_DIR}"
+
+MONITOR_LOG="${LOG_DIR}/${MODE}_${CONFIG_NAME}_nvidia_smi.csv"
+if command -v nvidia-smi >/dev/null 2>&1; then
+  nvidia-smi --query-gpu=timestamp,index,memory.used,memory.total,utilization.gpu --format=csv -l 5 > "${MONITOR_LOG}" &
+  MONITOR_PID=$!
+  trap 'kill ${MONITOR_PID} >/dev/null 2>&1 || true' EXIT
+fi
+
+if [[ "${MODE}" == "preflight" ]]; then
+  "${UV_BIN}" "${UV_RUN_ARGS[@]}" examples/custom_droid/preflight_custom_droid_batch.py \
+    --config-name "${CONFIG_NAME}" \
+    --batch-size "${PREFLIGHT_BATCH}"
+  echo "preflight complete"
+  exit 0
+fi
+
+# Norm stats are computed once from the full dataset and then reused from
+# assets/<config>/<repo_id>/norm_stats.json. "auto" computes them only if missing.
+NORM_STATS_FILE="assets/${CONFIG_NAME}/fitz0401/franka_pour_wine/norm_stats.json"
+if [[ "${RUN_NORM_STATS}" == "auto" && ! -f "${NORM_STATS_FILE}" ]]; then
+  RUN_NORM_STATS=true
+fi
+if [[ "${RUN_NORM_STATS}" == "true" ]]; then
+  "${UV_BIN}" "${UV_RUN_ARGS[@]}" scripts/compute_norm_stats.py \
+    --config-name "${CONFIG_NAME}" \
+    --max-frames "${NORM_MAX_FRAMES}"
+fi
+
+TRAIN_ARGS=(
+  "${CONFIG_NAME}"
+  --exp-name="${EXP_NAME}"
+  --batch-size="${GLOBAL_BATCH}"
+  --fsdp-devices="${FSDP_DEVICES}"
+  --num-train-steps="${NUM_TRAIN_STEPS}"
+  --log-interval="${LOG_INTERVAL}"
+  --save-interval="${SAVE_INTERVAL}"
+)
+if [[ -n "${EVAL_INTERVAL:-}" ]]; then
+  TRAIN_ARGS+=(--eval-interval="${EVAL_INTERVAL}")
+fi
+if [[ -n "${EVAL_NUM_BATCHES:-}" ]]; then
+  TRAIN_ARGS+=(--eval-num-batches="${EVAL_NUM_BATCHES}")
+fi
+
+if [[ "${WANDB_ENABLED}" == "false" ]]; then
+  TRAIN_ARGS+=(--no-wandb-enabled)
+fi
+if [[ "${RESUME}" == "true" ]]; then
+  TRAIN_ARGS+=(--resume)
+elif [[ "${OVERWRITE}" == "true" ]]; then
+  TRAIN_ARGS+=(--overwrite)
+fi
+
+"${UV_BIN}" "${UV_RUN_ARGS[@]}" scripts/train.py "${TRAIN_ARGS[@]}"
+
+echo "nvidia-smi monitor: ${MONITOR_LOG}"
