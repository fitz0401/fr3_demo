+
+
+@dataclasses.dataclass(frozen=True)
+class DroidInputsWithStateHistory(transforms.DataTransformFn):
+    """DroidInputs with past copies of the proprioceptive state appended to the state vector.
+
+    pi0.5 has no memory: one frame per camera, no observation history, and nothing carried between
+    calls. That makes phases of a task that look alike but need opposite actions -- carrying a bottle
+    towards the glass versus carrying it back -- indistinguishable. Stacking older proprioception onto
+    the state supplies that context without consuming a camera slot or adding image tokens.
+
+    The state is laid out current-first:
+
+        [q_t, grip_t, q_{t-lag0}, grip_{t-lag0}, q_{t-lag1}, grip_{t-lag1}, ...]
+
+    matching the ordering that `create_torch_dataset` writes into `delta_timestamps`. Index 0 of the
+    stacked axis is the present; taking index 0 to mean "the first lag" would silently train the model
+    on a stale state, which converges perfectly well and is wrong.
+
+    At inference the client sends the same stacked arrays -- shape `(1 + len(lags), 7)` for
+    `joint_position` and `(1 + len(lags),)` or `(1 + len(lags), 1)` for `gripper_position`, in the same
+    order -- so no separate code path is needed. When fewer than `lag` frames have elapsed the client
+    should repeat the current frame, which is what LeRobot's clamping does during training.
+    """
+
+    model_type: _model.ModelType
+    # Number of stacked state frames, i.e. 1 + len(state_history_lags). 1 reproduces plain DroidInputs.
+    num_state_frames: int = 1
+
+    def __call__(self, data: dict) -> dict:
+        joints = np.asarray(data["observation/joint_position"])
+        gripper = np.asarray(data["observation/gripper_position"])
+
+        # Accept both the unstacked (no history) and stacked (history) forms.
+        if joints.ndim == 1:
+            joints = joints[np.newaxis, :]
+        if gripper.ndim == 0:
+            gripper = gripper.reshape(1, 1)
+        elif gripper.ndim == 1:
+            # Either (frames,) with history, or (1,) without it.
+            gripper = gripper.reshape(-1, 1) if joints.shape[0] > 1 else gripper.reshape(1, -1)
+
+        if joints.shape[0] != self.num_state_frames or gripper.shape[0] != self.num_state_frames:
+            raise ValueError(
+                f"Expected {self.num_state_frames} stacked state frames, got joint_position "
+                f"{joints.shape} and gripper_position {gripper.shape}. The client must send the same "
+                "number of frames, current first, that the model was trained with."
+            )
+
+        # Current first; ravel keeps [q, grip] adjacent within each frame.
+        state = np.concatenate([np.concatenate([joints[i], gripper[i]]) for i in range(self.num_state_frames)])
+
+        base_image = _parse_image(data["observation/exterior_image_1_left"])
+        wrist_image = _parse_image(data["observation/wrist_image_left"])
+
+        match self.model_type:
+            case _model.ModelType.PI0 | _model.ModelType.PI05:
+                names = ("base_0_rgb", "left_wrist_0_rgb", "right_wrist_0_rgb")
+                images = (base_image, wrist_image, np.zeros_like(base_image))
+                image_masks = (np.True_, np.True_, np.False_)
+            case _:
+                raise ValueError(f"Unsupported model type: {self.model_type}")
+
+        inputs = {
+            "state": state,
+            "image": dict(zip(names, images, strict=True)),
+            "image_mask": dict(zip(names, image_masks, strict=True)),
+        }
+        if "actions" in data:
+            inputs["actions"] = np.asarray(data["actions"])
+        if "prompt" in data:
+            prompt = data["prompt"]
+            inputs["prompt"] = prompt.decode("utf-8") if isinstance(prompt, bytes) else prompt
+        return inputs
