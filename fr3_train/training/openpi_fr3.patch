index c8aef87..24b8863 100644
--- a/scripts/compute_norm_stats.py
+++ b/scripts/compute_norm_stats.py
@@ -86,6 +86,28 @@ def create_rlds_dataloader(
     return data_loader, num_batches
 
 
+def _tile_base_state_stats(stats: normalize.NormStats, num_frames: int) -> normalize.NormStats:
+    """Give every stacked state frame the same normalisation as the current one.
+
+    The stacked blocks hold the same physical quantities at different times, so they must share one
+    mapping: the whole point of the design is that the *difference* between blocks is readable, and
+    per-block quantiles would corrupt exactly that. They would also differ for a spurious reason --
+    the lagged blocks repeat each episode's first frame `lag` times because of LeRobot's clamping,
+    which drags their low quantiles towards the home pose.
+
+    The leading block is estimated on the unclamped current values, so it is the one to copy.
+    """
+    dim = stats.q01.shape[-1]
+    if dim % num_frames != 0:
+        raise ValueError(f"State dim {dim} is not divisible by {num_frames} stacked frames.")
+    base = dim // num_frames
+
+    def tile(x):
+        return None if x is None else np.tile(x[..., :base], num_frames)
+
+    return normalize.NormStats(mean=tile(stats.mean), std=tile(stats.std), q01=tile(stats.q01), q99=tile(stats.q99))
+
+
 def main(config_name: str, max_frames: int | None = None):
     config = _config.get_config(config_name)
     data_config = config.data.create(config.assets_dirs, config.model)
@@ -108,6 +130,9 @@ def main(config_name: str, max_frames: int | None = None):
 
     norm_stats = {key: stats.get_statistics() for key, stats in stats.items()}
 
+    if data_config.state_history_lags:
+        norm_stats["state"] = _tile_base_state_stats(norm_stats["state"], 1 + len(data_config.state_history_lags))
+
     output_path = config.assets_dirs / data_config.repo_id
     print(f"Writing stats to: {output_path}")
     normalize.save(output_path, norm_stats)
diff --git a/scripts/eval_offline.py b/scripts/eval_offline.py
new file mode 100644
index 0000000..c6d8b5c
--- /dev/null
+++ b/scripts/eval_offline.py
@@ -0,0 +1,176 @@
+"""Offline evaluation of one or more saved checkpoints.
+
+Forward passes only -- no optimizer, no gradients. For each requested step it restores the params,
+runs the shared validation metrics from `openpi.training.evaluation` over a fixed set of batches,
+and writes one JSON per checkpoint plus a summary table.
+
+Example:
+
+    uv run scripts/eval_offline.py --config-name pi05_custom_droid_hybrid \
+        --exp-name b0_custom_droid_full_15k \
+        --steps 5000,10000,14999 \
+        --split val --val-episodes 4,12,17 \
+        --num-batches 16
+
+Note on interpretation: if the checkpoints being evaluated were trained on the episodes named by
+--val-episodes (as is the case for the original `b0_custom_droid_full_15k` run, which used all 20),
+the numbers are in-sample. In-sample loss falls monotonically with training, so it measures fit,
+not generalization, and must not be used to pick a "best" checkpoint.
+"""
+
+import dataclasses
+import json
+import logging
+import pathlib
+
+import etils.epath as epath
+import jax
+import jax.numpy as jnp
+import tyro
+
+import openpi.models.model as _model
+import openpi.training.config as _config
+import openpi.training.data_loader as _data_loader
+import openpi.training.evaluation as _evaluation
+import openpi.training.sharding as sharding
+
+
+@dataclasses.dataclass
+class Args:
+    # Name of the training config the checkpoints were produced with. This must be the config the
+    # model was *trained* with: it determines the architecture and, importantly, the norm stats.
+    config_name: str
+    # Experiment name, i.e. the checkpoint sub-directory. Defaults to the config's exp_name.
+    exp_name: str | None = None
+    # Explicit checkpoint directory; overrides config_name/exp_name based lookup.
+    checkpoint_dir: str | None = None
+    # Comma-separated steps to evaluate. Defaults to every step present in the checkpoint dir.
+    steps: str | None = None
+    # Which split to evaluate on.
+    split: str = "val"
+    # Comma-separated validation episodes. Defaults to the config's val_episodes.
+    val_episodes: str | None = None
+    # Number of batches per checkpoint. 16 batches x 64 = 1024 windows is enough for a stable mean.
+    num_batches: int = 16
+    # Batch size; defaults to the training batch size.
+    batch_size: int | None = None
+    # Seed for the fixed validation noise/time draws. Must match across checkpoints to compare them.
+    seed: int = 0
+    # Whether to also sample actions and report action-space errors (costs num_denoise_steps
+    # forward passes per batch, but these are the interpretable numbers).
+    sample_actions: bool = True
+    num_denoise_steps: int = 10
+    # Where to write results. Defaults to artifacts/eval/<exp_name>.
+    out_dir: str | None = None
+
+
+def _parse_ints(value: str | None) -> tuple[int, ...] | None:
+    if value is None:
+        return None
+    return tuple(int(part) for part in value.replace(" ", "").split(",") if part)
+
+
+def main(args: Args) -> None:
+    # force=True: importing jax/absl installs a root handler above INFO, which makes a plain
+    # basicConfig() a silent no-op and swallows every logging call in this script.
+    logging.basicConfig(
+        level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s", datefmt="%H:%M:%S", force=True
+    )
+
+    config = _config.get_config(args.config_name)
+    if args.exp_name is not None:
+        config = dataclasses.replace(config, exp_name=args.exp_name)
+    checkpoint_dir = epath.Path(args.checkpoint_dir) if args.checkpoint_dir else epath.Path(config.checkpoint_dir)
+    if not checkpoint_dir.exists():
+        raise FileNotFoundError(f"Checkpoint directory {checkpoint_dir} does not exist.")
+
+    steps = _parse_ints(args.steps)
+    if steps is None:
+        steps = tuple(sorted(int(p.name) for p in checkpoint_dir.iterdir() if p.is_dir() and p.name.isdigit()))
+    if not steps:
+        raise ValueError(f"No checkpoints found in {checkpoint_dir}.")
+
+    val_episodes = _parse_ints(args.val_episodes)
+    if val_episodes is None:
+        val_episodes = config.val_episodes
+    if args.split != "all" and not val_episodes:
+        raise ValueError(f"--split={args.split} needs --val-episodes (the config defines none).")
+
+    out_dir = pathlib.Path(args.out_dir or f"artifacts/eval/{config.exp_name}")
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    mesh = sharding.make_mesh(config.fsdp_devices)
+    data_sharding = jax.sharding.NamedSharding(mesh, jax.sharding.PartitionSpec(sharding.DATA_AXIS))
+
+    # shuffle=False so that every checkpoint sees exactly the same windows in the same order.
+    data_loader = _data_loader.create_data_loader(
+        config,
+        sharding=data_sharding,
+        shuffle=False,
+        split=args.split,
+        val_episodes=val_episodes,
+        batch_size=args.batch_size,
+    )
+
+    results = {}
+    for step in steps:
+        params_path = checkpoint_dir / str(step) / "params"
+        if not params_path.exists():
+            raise FileNotFoundError(f"No params at {params_path}.")
+        logging.info(f"=== step {step}: loading {params_path}")
+        model = config.model.load(_model.restore_params(params_path, dtype=jnp.bfloat16))
+
+        with sharding.set_mesh(mesh):
+            metrics = _evaluation.evaluate_model(
+                model,
+                data_loader,
+                num_batches=args.num_batches,
+                seed=args.seed,
+                sample_actions=args.sample_actions,
+                num_denoise_steps=args.num_denoise_steps,
+            )
+        metrics |= {
+            "step": step,
+            "config_name": config.name,
+            "checkpoint_dir": str(checkpoint_dir),
+            "split": args.split,
+            "val_episodes": list(val_episodes),
+            "seed": args.seed,
+            "batch_size": args.batch_size or config.batch_size,
+            "num_denoise_steps": args.num_denoise_steps if args.sample_actions else None,
+        }
+        results[step] = metrics
+        (out_dir / f"eval_step{step}.json").write_text(json.dumps(metrics, indent=2))
+        logging.info(f"step {step}: " + ", ".join(f"{k}={v:.5f}" for k, v in metrics.items() if isinstance(v, float)))
+        del model
+
+    summary_path = out_dir / "eval_summary.json"
+    summary_path.write_text(json.dumps({str(k): v for k, v in results.items()}, indent=2))
+
+    scalar_keys = [
+        "val_loss",
+        "action_mse_phys",
+        "action_mae_phys",
+        "gripper_mae",
+        "pred_stall_frac",
+        "gt_stall_frac",
+        "creep_speed_p50",
+        "creep_speed_p90",
+        "moving_speed_p50",
+        "creep_ratio",
+        "pred_abs_joint_mean",
+        "gt_abs_joint_mean",
+    ]
+    header = f"{'step':>8} " + " ".join(f"{k:>19}" for k in scalar_keys if k in next(iter(results.values())))
+    print("\n" + header)
+    print("-" * len(header))
+    for step, metrics in sorted(results.items()):
+        row = f"{step:>8} " + " ".join(
+            f"{metrics[k]:>19.6f}" for k in scalar_keys if k in metrics and isinstance(metrics[k], float)
+        )
+        print(row)
+    print(f"\nWrote {summary_path}")
+
+
+if __name__ == "__main__":
+    main(tyro.cli(Args))
diff --git a/scripts/launch_leonardo_4gpu_eval.sh b/scripts/launch_leonardo_4gpu_eval.sh
new file mode 100755
index 0000000..bb24b7e
--- /dev/null
+++ b/scripts/launch_leonardo_4gpu_eval.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Offline evaluation of saved checkpoints on one Leonardo Booster node (4x A100 64GB).
+# Forward passes only, so this is far cheaper than training: budget ~5 min per checkpoint.
+#
+#   CKPT_STEPS=5000,10000,14999 bash scripts/launch_leonardo_4gpu_eval.sh
+#
+# Environment overrides: CONFIG_NAME, EXP_NAME, CKPT_STEPS, SPLIT, VAL_EPISODES, NUM_BATCHES,
+# EVAL_BATCH_SIZE, SAMPLE_ACTIONS, OUT_DIR.
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "${ROOT_DIR}"
+
+WORK_ROOT="${WORK_ROOT:-/leonardo_work/EUHPC_D35_005}"
+export HF_LEROBOT_HOME="${HF_LEROBOT_HOME:-${WORK_ROOT}/datasets/lerobot}"
+export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-${WORK_ROOT}/.cache/openpi}"
+export HF_HOME="${HF_HOME:-${WORK_ROOT}/.cache/huggingface}"
+export UV_CACHE_DIR="${UV_CACHE_DIR:-${WORK_ROOT}/.cache/uv}"
+export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-${WORK_ROOT}/.cache/uv/python}"
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
+export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
+export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-false}"
+export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${WORK_ROOT}/.cache/jax}"
+export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
+
+CONFIG_NAME="${CONFIG_NAME:-pi05_custom_droid_hybrid}"
+EXP_NAME="${EXP_NAME:-b0_custom_droid_full_15k}"
+CKPT_STEPS="${CKPT_STEPS:-}"
+SPLIT="${SPLIT:-val}"
+# Empty by default: eval_offline.py then falls back to the train config's own val_episodes,
+# which is the only place that knows the right split for a given dataset. Hard-coding a
+# default here silently evaluated wine checkpoints on custom_droid's episodes once.
+VAL_EPISODES="${VAL_EPISODES:-}"
+NUM_BATCHES="${NUM_BATCHES:-16}"
+EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-64}"
+SAMPLE_ACTIONS="${SAMPLE_ACTIONS:-true}"
+OUT_DIR="${OUT_DIR:-artifacts/eval/${EXP_NAME}}"
+UV_BIN="${UV_BIN:-${WORK_ROOT}/conda/envs/jepa-wms/bin/uv}"
