index 0000000..cda7f96
--- /dev/null
+++ b/src/openpi/training/evaluation.py
@@ -0,0 +1,234 @@
+"""Validation metrics shared by in-loop training validation and the offline eval script.
+
+Keeping the metric definitions in one place means a number reported by `scripts/eval_offline.py`
+means exactly the same thing as the one logged during training.
+
+Two families of metrics are computed:
+
+* `val_loss` -- the flow-matching denoising loss with `train=False`. It is cheap (one forward pass)
+  and is what training uses to rank checkpoints. It is only comparable across checkpoints if the
+  noise and timestep draws are held fixed, which is why the rng is derived from a fixed seed and
+  the batch index rather than from the training rng.
+* action-space errors -- obtained by actually sampling actions with the flow-matching solver and
+  comparing against the demonstration. These are what a human can interpret (rad/s of joint
+  velocity error), but they cost `num_denoise_steps` forward passes, so by default only the offline
+  script computes them.
+"""
+
+from collections.abc import Iterator
+import dataclasses
+
+import flax.nnx as nnx
+import jax
+import jax.numpy as jnp
+import numpy as np
+
+import openpi.models.model as _model
+import openpi.shared.array_typing as at
+import openpi.shared.nnx_utils as nnx_utils
+import openpi.transforms as _transforms
+
+
+def eval_loss(
+    model: _model.BaseModel,
+    rng: at.KeyArrayLike,
+    observation: _model.Observation,
+    actions: _model.Actions,
+) -> at.Array:
+    """Mean denoising loss of one batch, with dropout and other train-time randomness disabled."""
+    model.eval()
+    return jnp.mean(model.compute_loss(rng, observation, actions, train=False))
+
+
+def eval_loss_from_state(
+    model_def: nnx.GraphDef,
+    params: nnx.State,
+    rng: at.KeyArrayLike,
+    batch: tuple[_model.Observation, _model.Actions],
+) -> at.Array:
+    """`eval_loss` against a train state's (model_def, params) pair, so it can be jitted in-loop."""
+    model = nnx.merge(model_def, params)
+    observation, actions = batch
+    return eval_loss(model, rng, observation, actions)
+
+
+def unnormalize_actions(actions: np.ndarray, norm_stats, *, use_quantiles: bool) -> np.ndarray:
+    """Map normalized actions back to physical units, dropping the padding dimensions.
+
+    Mirrors `openpi.transforms.Unnormalize`, but returns only the real (unpadded) action
+    dimensions, since errors on the zero-padding are meaningless.
+    """
+    stats = norm_stats["actions"]
+    if use_quantiles:
+        q01, q99 = np.asarray(stats.q01), np.asarray(stats.q99)
+        dim = q01.shape[-1]
+        return (actions[..., :dim] + 1.0) / 2.0 * (q99 - q01 + 1e-6) + q01
+    mean, std = np.asarray(stats.mean), np.asarray(stats.std)
+    dim = mean.shape[-1]
+    return actions[..., :dim] * (std + 1e-6) + mean
+
+
+@dataclasses.dataclass
+class ActionErrorAccumulator:
+    """Accumulates action-space errors over batches.
+
+    `gripper_index` is the index of the gripper dimension within the real action dims; the
+    remaining dims are treated as joint velocities. For this dataset actions are
+    7 joint velocities + 1 gripper, so the gripper is the last of 8 dims.
+    """
+
+    gripper_index: int = -1
+    # A joint-velocity command whose L-infinity norm is below this is treated as "not moving".
+    # 1e-3 rad/s is well below the smallest commanded motion in the data and above float noise.
+    stall_threshold: float = 1e-3
+
+    def __post_init__(self):
+        self._n = 0
+        self._sq_err = None  # [horizon, dim]
+        self._abs_err = None  # [horizon, dim]
+        self._sq_err_norm = 0.0
+        self._pred_stall = 0
+        self._gt_stall = 0
+        self._steps = 0
+        self._pred_absmean = 0.0
+        self._gt_absmean = 0.0
+        # Predicted joint speed split by whether the demonstration is holding still, kept as raw
+        # values so percentiles can be reported. `pred_stall_frac` alone is misleading for a
+        # continuous-output policy: exact zeros are a measure-zero event, so it is near zero by
+        # construction. What matters for deployment is how fast the arm creeps when it should hold.
+        self._pred_speed_gt_zero: list[np.ndarray] = []
+        self._pred_speed_gt_move: list[np.ndarray] = []
+
+    def _joint_dims(self, dim: int) -> tuple[int, list[int]]:
+        gripper = self.gripper_index % dim
+        return gripper, [i for i in range(dim) if i != gripper]
+
+    def update(self, pred_phys: np.ndarray, gt_phys: np.ndarray, pred_norm: np.ndarray, gt_norm: np.ndarray) -> None:
+        """Add one batch. `*_phys` are [batch, horizon, dim] in physical units, `*_norm` normalized."""
+        err = pred_phys - gt_phys
+        sq, ab = np.square(err).sum(axis=0), np.abs(err).sum(axis=0)
+        self._sq_err = sq if self._sq_err is None else self._sq_err + sq
+        self._abs_err = ab if self._abs_err is None else self._abs_err + ab
+        self._n += pred_phys.shape[0]
+        self._sq_err_norm += float(np.square(pred_norm - gt_norm).sum())
+
+        _, joints = self._joint_dims(pred_phys.shape[-1])
+        pred_j, gt_j = pred_phys[..., joints], gt_phys[..., joints]
+        pred_speed, gt_speed = np.abs(pred_j).max(axis=-1), np.abs(gt_j).max(axis=-1)
+        gt_holding = gt_speed < self.stall_threshold
+        self._pred_stall += int((pred_speed < self.stall_threshold).sum())
+        self._gt_stall += int(gt_holding.sum())
+        self._steps += int(pred_j.shape[0] * pred_j.shape[1])
+        self._pred_absmean += float(np.abs(pred_j).sum())
+        self._gt_absmean += float(np.abs(gt_j).sum())
+        self._pred_speed_gt_zero.append(pred_speed[gt_holding])
+        self._pred_speed_gt_move.append(pred_speed[~gt_holding])
+
+    def result(self) -> dict:
+        if self._n == 0:
+            raise ValueError("No batches accumulated.")
+        horizon, dim = self._sq_err.shape
+        gripper, joints = self._joint_dims(dim)
+        mse_per_dim = self._sq_err / self._n  # [horizon, dim]
+        mae_per_dim = self._abs_err / self._n
+        joint_scale = self._n * horizon * len(joints)
+        return {
+            # Headline numbers, in physical units (rad/s for joints, [0,1] for the gripper).
+            "action_mse_phys": float(mse_per_dim[:, joints].mean()),
+            "action_mae_phys": float(mae_per_dim[:, joints].mean()),
+            "gripper_mae": float(mae_per_dim[:, gripper].mean()),
+            # Normalized-space MSE, comparable to the training loss scale.
+            "action_mse_norm": float(self._sq_err_norm / (self._n * horizon * dim)),
+            # Per-dimension and per-horizon-step breakdowns.
+            "mae_per_joint": [float(v) for v in mae_per_dim[:, joints].mean(axis=0)],
+            "mae_per_horizon": [float(v) for v in mae_per_dim[:, joints].mean(axis=-1)],
+            # Stall diagnostics: 27.2% of frames in this dataset carry an exactly-zero action, so a
+            # policy that learns to freeze would still score a decent loss. A predicted stall rate
+            # far above the ground-truth one is the signature of that failure.
+            "pred_stall_frac": self._pred_stall / self._steps,
+            "gt_stall_frac": self._gt_stall / self._steps,
+            "pred_abs_joint_mean": self._pred_absmean / joint_scale,
+            "gt_abs_joint_mean": self._gt_absmean / joint_scale,
+            "num_samples": self._n,
+            **self._creep_metrics(),
+        }
+
+    def _creep_metrics(self) -> dict:
+        """How fast the policy moves on the steps where the demonstration holds still.
+
+        `creep_ratio` is the headline: the median predicted speed during a demonstrated hold,
+        divided by the median predicted speed while the demonstration is moving. Near 0 means the
+        policy reproduces holds; near 1 means it ignores them and keeps drifting.
+        """
+        held = np.concatenate(self._pred_speed_gt_zero) if self._pred_speed_gt_zero else np.zeros(0)
+        moving = np.concatenate(self._pred_speed_gt_move) if self._pred_speed_gt_move else np.zeros(0)
+        if held.size == 0 or moving.size == 0:
+            return {}
+        held_p50, held_p90 = (float(v) for v in np.percentile(held, [50, 90]))
+        moving_p50 = float(np.percentile(moving, 50))
+        return {
+            "creep_speed_p50": held_p50,
+            "creep_speed_p90": held_p90,
+            "creep_speed_mean": float(held.mean()),
+            "moving_speed_p50": moving_p50,
+            "creep_ratio": held_p50 / (moving_p50 + 1e-9),
+            "num_held_steps": int(held.size),
+        }
+
+
+def iter_batches(data_loader, num_batches: int) -> Iterator:
+    """First `num_batches` batches of a (possibly infinite) data loader."""
+    it = iter(data_loader)
+    for _ in range(num_batches):
+        yield next(it)
+
+
+def evaluate_model(
+    model: _model.BaseModel,
+    data_loader,
+    *,
+    num_batches: int,
+    seed: int = 0,
+    sample_actions: bool = False,
+    num_denoise_steps: int = 10,
+) -> dict:
+    """Run validation over `num_batches` batches and return the aggregated metrics."""
+    data_config = data_loader.data_config()
+    eval_rng = jax.random.key(seed)
+
+    # Freeze the module state and jit the two methods: running a 3B-parameter model op-by-op in
+    # eager mode is orders of magnitude slower than a single compiled call.
+    model.eval()
+    loss_fn = nnx_utils.module_jit(model.compute_loss, static_argnames=("train",))
+    sample_fn = nnx_utils.module_jit(model.sample_actions, static_argnames=("num_steps",)) if sample_actions else None
+
+    losses = []
+    errors = ActionErrorAccumulator() if sample_actions else None
+    for i, (observation, actions) in enumerate(iter_batches(data_loader, num_batches)):
+        batch_rng = jax.random.fold_in(eval_rng, i)
+        losses.append(float(jnp.mean(loss_fn(batch_rng, observation, actions, train=False))))
+
+        if errors is not None:
+            pred = np.asarray(jax.device_get(sample_fn(batch_rng, observation, num_steps=num_denoise_steps)))
+            gt = np.asarray(jax.device_get(actions))
+            dim = np.asarray(data_config.norm_stats["actions"].q01).shape[-1]
+            errors.update(
+                unnormalize_actions(pred, data_config.norm_stats, use_quantiles=data_config.use_quantile_norm),
+                unnormalize_actions(gt, data_config.norm_stats, use_quantiles=data_config.use_quantile_norm),
+                pred[..., :dim],
+                gt[..., :dim],
+            )
+
+    metrics = {
+        "val_loss": float(np.mean(losses)),
+        "val_loss_std": float(np.std(losses)),
+        "num_batches": num_batches,
+    }
+    if errors is not None:
+        metrics |= errors.result()
+    return metrics
+
+
+def unnormalize_transform(data_config) -> _transforms.Unnormalize:
+    """The Unnormalize transform matching a data config, for callers that want the full pipeline."""
+    return _transforms.Unnormalize(data_config.norm_stats, use_quantiles=data_config.use_quantile_norm)
