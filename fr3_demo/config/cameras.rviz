Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Exterior Image Left
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fr3_demo/exterior_image_left
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fr3_demo/wrist_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Exterior Image 2 Left (optional)
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fr3_demo/exterior_image_2_left
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: exterior_camera
  Name: root
Window Geometry:
  Height: 900
  Width: 1400
